{
  "name": "roanoke-baptist-site",
  "private": true,
  "type": "module",
  "description": "Roanoke Baptist Church website and the Torch newsletter editor",
  "scripts": {
    "setup": "node setup.mjs",
    "dev": "wrangler dev --persist-to ../.wrangler-state/roanoke",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute roanoke-torch --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute roanoke-torch --local --file=./schema.sql",
    "seed": "wrangler d1 execute roanoke-torch --remote --file=./seed-2026-08.sql",
    "seed:local": "wrangler d1 execute roanoke-torch --local --file=./seed-2026-08.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
